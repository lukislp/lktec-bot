{
  "name": "REPLACE-ME-my-repo-bot",
  "url": "https://github.com/lukislp/lktec-bot",
  "description": "Least-privilege repository automation (lktec-bot): automerge, lockfiles, release, sync.",
  "redirect_url": "http://localhost/",
  "public": false,
  "request_oauth_on_install": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "issues": "write",
    "checks": "write",
    "metadata": "read"
  }
}
